# =============================================================================
# VINCI Facilities AI Demo - configuration
# Copy to .env (python scripts/bootstrap_env.py does it and generates the secrets).
# Never commit the .env file.
# =============================================================================

# --- General ------------------------------------------------------------------
# true  = deterministic offline demo: rule-based extraction, simulated notifications,
#         no call to Gemini or n8n even if keys are present.
# false = real integrations are used when configured (missing ones are reported as such).
DEMO_MODE=true
LOG_LEVEL=INFO

# Shared secret between the Streamlit frontend and the FastAPI backend (header X-API-Key).
API_KEY=

# --- Storage ------------------------------------------------------------------
# SQLite database, uploads and ChromaDB index live in DATA_DIR.
DATA_DIR=./data
# Optional explicit SQLAlchemy URL (defaults to sqlite:///<DATA_DIR>/maintenance.db)
DATABASE_URL=
SEED_ON_STARTUP=true

# --- Generative AI --------------------------------------------------------------
# Provider used when DEMO_MODE=false: gemini or mistral
LLM_PROVIDER=gemini
# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Mistral AI (https://console.mistral.ai/api-keys)
MISTRAL_API_KEY=
MISTRAL_MODEL=ministral-14b-latest

# --- Document processing --------------------------------------------------------
MAX_UPLOAD_MB=10
# Folder containing fra.traineddata (python scripts/download_tessdata.py fills ./data/tessdata)
TESSDATA_DIR=

# --- RAG ------------------------------------------------------------------------
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_TOP_K=5
RAG_MIN_SCORE=0.84
# Threshold used only by the lexical fallback (EMBEDDING_BACKEND=hashing)
RAG_MIN_SCORE_HASHING=0.30

# --- Analytics ------------------------------------------------------------------
RECURRENCE_THRESHOLD=3
RECURRENCE_WINDOW_DAYS=30

# --- n8n automation ---------------------------------------------------------------
# Production webhook URLs of the imported workflow (automation/n8n_workflow.json)
N8N_PROCESSING_WEBHOOK_URL=
N8N_FOLLOWUP_WEBHOOK_URL=
# Sent by FastAPI to n8n in the X-Webhook-Secret header (n8n "Header Auth" credential)
N8N_WEBHOOK_SECRET=
# Sent by n8n to FastAPI in the X-N8N-Token header (only grants the automation callbacks)
N8N_API_TOKEN=
# Base URL n8n uses to call FastAPI back (http://backend:8000 inside Docker Compose)
N8N_CALLBACK_BASE_URL=http://localhost:8000
# Recipient of follow-up emails. SMTP itself is configured in n8n (SMTP credential).
NOTIFICATION_EMAIL=

# --- Frontend ---------------------------------------------------------------------
BACKEND_URL=http://localhost:8000
